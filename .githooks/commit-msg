#!/usr/bin/env python3
"""Git commit-msg hook to validate Conventional Commits format."""

import re
import sys

# Pattern for Conventional Commits specification:
# <type>[optional scope]: <description>
CONVENTIONAL_COMMIT_REGEX = (
    r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)"
    r"(\([a-z0-9_.-]+\))?(!)?: .+"
)


def validate_commit_message(msg_path: str) -> bool:
    with open(msg_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    # Filter out empty lines and comments
    content_lines = [
        line.strip() for line in lines if line.strip() and not line.strip().startswith("#")
    ]

    if not content_lines:
        print("\033[1;31m[ERROR]\033[0m Commit message is empty.")
        return False

    first_line = content_lines[0]

    # Ignore standard git automated messages
    if first_line.startswith(("Merge ", "Revert ", "fixup!", "squash!")):
        return True

    if not re.match(CONVENTIONAL_COMMIT_REGEX, first_line):
        print("\n\033[1;31m[INVALID COMMIT MESSAGE]\033[0m")
        print(f"Your commit message does not adhere to Conventional Commits:")
        print(f"  \033[33m\"{first_line}\"\033[0m\n")
        print("Required format:")
        print("  \033[32m<type>(<scope>): <subject>\033[0m  or  \033[32m<type>: <subject>\033[0m\n")
        print("Allowed types:")
        print("  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert\n")
        print("Examples:")
        print("  feat(ui): add badge preview generator")
        print("  fix(cache): resolve ttl expiration issue")
        print("  docs: update readme with quickstart instructions\n")
        return False

    return True


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: commit-msg <path-to-commit-message-file>")
        sys.exit(1)

    if not validate_commit_message(sys.argv[1]):
        sys.exit(1)

    sys.exit(0)
